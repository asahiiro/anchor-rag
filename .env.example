# local 或 openai-compatible
EMBEDDING_PROVIDER=local

# 使用 openai-compatible 时填写
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# 文本生成目前支持 openai-compatible
GENERATION_PROVIDER=openai-compatible
GENERATION_BASE_URL=https://api.openai.com/v1
GENERATION_API_KEY=
GENERATION_MODEL=

# PostgreSQL 本地开发配置
POSTGRES_DB=anchor_rag
POSTGRES_USER=anchor_rag
POSTGRES_PASSWORD=anchor_rag_dev
DATABASE_URL=postgres://anchor_rag:anchor_rag_dev@localhost:5432/anchor_rag?sslmode=disable

# memory 或 postgres
STORAGE_PROVIDER=memory
